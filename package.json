{
  "name": "agent-base",
  "version": "0.7.1",
  "description": "开源桌面端 AI Agent 壳：Agent 循环引擎 + 插件/MCP 生态 + 多会话 + 审批治理",
  "type": "module",
  "main": "dist/src/electron/main.js",
  "author": "noeticforge",
  "contributors": [
    "Ljj041120 (https://github.com/Ljj041120)"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "node dist/src/cli.js",
    "smoke": "node dist/scripts/smoke.js",
    "test:unit": "vitest run",
    "test:ipc": "node dist/scripts/ipc-selftest.js",
    "test:window": "electron dist/scripts/window-selftest.js",
    "check:codes": "node scripts/check-error-codes.mjs",
    "serve:vtx": "python scripts/serve-vtx-embed.py",
    "live:check": "node dist/scripts/live-check.js",
    "test:subagent": "node dist/scripts/subagent-e2e.js config.e2e.json forced && node dist/scripts/subagent-e2e.js config.e2e.json auto && node dist/scripts/subagent-e2e.js config.e2e.json trivial",
    "dist": "electron-builder",
    "electron": "electron dist/src/electron/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "ajv": "^8.20.0",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.11",
    "zod": "^4.5.2"
  }
}